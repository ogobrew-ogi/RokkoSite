# ============================================================
#  Cloudflare Pages — HTTP Security Headers
#  Файлът трябва да е в основната (root) директория на проекта
# ============================================================

/*
  # PRE-LAUNCH ONLY — премахни този ред, когато сме готови за реално
  # индексиране (съдържание/цени/контакти финализирани). Работи дори
  # ако robots.txt/meta robots бъдат пропуснати от някой краулър.
  X-Robots-Tag: noindex, nofollow

  # Предотвратява зареждане на сайта в iframe от друг домейн (clickjacking)
  X-Frame-Options: SAMEORIGIN

  # Браузърът не трябва да познае content-type (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Изпраща само origin при cross-origin заявки (privacy)
  Referrer-Policy: strict-origin-when-cross-origin

  # Забранява достъп до камера, микрофон, GPS (не са нужни за сайта)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Принуждава HTTPS за 1 година, включва поддомейни
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy — разрешава само доверени източници
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com data:; connect-src 'self'; frame-ancestors 'none';

  # Забранява Adobe Flash и PDF embed в IE/Edge legacy
  X-Permitted-Cross-Domain-Policies: none

# Статичните assets се кешират агресивно (1 година)
# Ако сменяш CSS/JS, добави ?v=2 към URL-а в HTML-а
/style.css
  Cache-Control: public, max-age=31536000, immutable

/main.js
  Cache-Control: public, max-age=31536000, immutable

# Снимки — кеш за 7 дни (не 1 година/immutable като CSS/JS), защото
# файловите имена НЕ са версионирани (1.jpg си остава 1.jpg дори когато
# подмениш съдържанието му). По-дълъг кеш би скрил бъдещи подмени на
# снимки с до 1 година за вече посетили сайта потребители.
# Когато снимките са финални (след launch), смени на:
#   Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=604800, must-revalidate

# HTML никога не се кешира (за да виждат потребителите промените веднага)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/404.html
  Cache-Control: no-cache, no-store, must-revalidate
